{
  "name": "exchain",
  "version": "0.1.0",
  "description": "ExChain — Breakup on-chain calculator & relationship lock",
  "type": "module",
  "main": "src/agent/index.ts",
  "bin": {
    "exchain": "src/agent/cli.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/agent/cli.ts",
    "dev:server": "tsx src/server/index.ts",
    "dev:web": "cd web && npm run dev",
    "dev:willchain:server": "tsx src/willchain/server/index.ts",
    "dev:willchain:web": "cd willchain-web && npm run dev",
    "dev:coinsoul:server": "tsx src/coinsoul/server/index.ts",
    "dev:coinsoul:web": "cd coinsoul-web && npm run dev",
    "coinsoul": "tsx src/coinsoul/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "blockchain",
    "onchainos",
    "breakup",
    "defi",
    "agent",
    "okx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Louis0929/exchain"
  },
  "bugs": {
    "url": "https://github.com/yourusername/exchain/issues"
  },
  "homepage": "https://github.com/yourusername/exchain",
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1"
  }
}
